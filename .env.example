# SentinelBoard Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Django ──────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Redis ───────────────────────────────────────
# Collector → Parser arasındaki log kuyruğu (Redis Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Alerts: Telegram ────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ── LLM: Groq ───────────────────────────────────
# Alert analizi, event açıklaması ve güvenlik chatbot'u için
GROQ_API_KEY=your-groq-api-key-here

# ── ML Module ───────────────────────────────────
ML_BASELINE_DAYS=7
ML_ANOMALY_THRESHOLD=2.5

# ── Collector ───────────────────────────────────
LOG_SOURCES=/var/log/auth.log,/var/log/syslog,/var/log/nginx/access.log
COLLECTOR_BATCH_SIZE=100
COLLECTOR_FLUSH_INTERVAL=5