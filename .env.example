# SentinelBoard Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Django ──────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ──────────────────────────────────
DB_NAME=sentinelboard
DB_USER=sentinel
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ── Redis ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Alerts: Telegram ────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Alerts: Email (SMTP) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENT=admin@example.com

# ── ML Module ───────────────────────────────────
ML_BASELINE_DAYS=7
ML_ANOMALY_THRESHOLD=2.5

# ── Collector ───────────────────────────────────
LOG_SOURCES=/var/log/auth.log,/var/log/syslog,/var/log/nginx/access.log
COLLECTOR_BATCH_SIZE=100
COLLECTOR_FLUSH_INTERVAL=5
